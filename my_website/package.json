{
  "name": "malcolm-armstrong-portfolio",
  "version": "1.0.0",
  "description": "Minimalist portfolio site with journal, built with Eleventy",
  "scripts": {
    "start": "eleventy --serve",
    "build": "eleventy",
    "optimize": "node scripts/optimize-images.js",
    "build:prod": "NODE_ENV=production npm run build && npm run optimize",
    "panel": "node dev-panel.js"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0"
  },
  "dependencies": {
    "@11ty/eleventy-img": "^7.1.1"
  },
  "overrides": {
    "liquidjs": "^10.26.0",
    "handlebars": "^4.7.8",
    "markdown-it": "^14.1.0",
    "js-yaml": "^4.1.0",
    "minimatch": "^9.0.5",
    "sharp": "^0.35.5",
    "image-size": "^1.2.0"
  }
}
